# In case of basic auth or no auth remove the /auth location
# In case of basic auth comment auth_basic and auth_basic_user_file in

# effectively disabling the read timeout
proxy_read_timeout 1d;

# disable emitting nginx version
server_tokens off;

# Allow 100mb uploads
client_max_body_size 101M;

# Prefer forwarded values from ingress/reverse proxies when present.
set $forwarded_proto $http_x_forwarded_proto;
if ($forwarded_proto = "") { set $forwarded_proto $scheme; }

set $effective_host $http_x_forwarded_host;
if ($effective_host = "") { set $effective_host $host; }

location = / {
    return 302 $scheme://$http_host${GUI_BASE_PATH}/;
}

location = ${GUI_BASE_PATH} {
    # auth_basic           "Car GUI";
    # auth_basic_user_file /etc/nginx/htpasswd;
    return 301 $scheme://$http_host${GUI_BASE_PATH}/;
}

# prometheus endpoint should not be accessible
location ${SERVER_CONTEXT_PATH}/prometheus {
    return 403;
}

# only the local installation (inst/1) may resolve admin plugin assets from the GUI container;
# all other installation-scoped admin assets must fall through to the backend proxy so they can
# be forwarded to the owning remote instance.

# local inst/1 GUI assets are served directly by car_gui (no rewrite needed)
location ~ ^${GUI_BASE_PATH}/gui/V1/inst/1/(?<asset>[^/]+\.(?:js|mjs|map|json|css|html|ico|jpg|jpeg|png|svg|ttf|webp|woff|woff2))$ {
    proxy_pass         http://car_gui;
}

# asset routing to serve assets from legacy API
location ~ ^${SERVER_CONTEXT_PATH}/admin/V3/inst/1/(?<asset>[^/]+\.(?:js|mjs|map|json|css|html|ico|jpg|jpeg|png|svg|ttf|webp|woff|woff2))$ {
    proxy_pass         http://car_gui;
}

# backend
location ~ ^${SERVER_CONTEXT_PATH}/(car|api|admin|gui|guiconfig|info|refresh|stop|health|metrics|operations|license|configuration|swagger-ui|swagger|routes|execute)(/.*)?$ {

    # auth_basic           "Car Service";
    # auth_basic_user_file /etc/nginx/htpasswd;

    proxy_set_header   Host $effective_host;
    proxy_set_header   X-Forwarded-Server $effective_host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Prefix "${SERVER_CONTEXT_PATH}";
    proxy_set_header   X-Forwarded-Prefix-Present "true";
    proxy_set_header   X-Forwarded-Host $effective_host;
    proxy_set_header   X-Forwarded-Proto $forwarded_proto;
    proxy_set_header   X-Forwarded-Port $forwarded_port;

    rewrite            ^ $request_uri;
    rewrite            ^${SERVER_CONTEXT_PATH}(.*)$ $1 break;
    return 400;
    proxy_pass         http://car_backend$uri;
}

location ${GUI_BASE_PATH}/ {
    proxy_set_header   Host $effective_host;
    proxy_set_header   X-Forwarded-Server $effective_host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Host $effective_host;
    proxy_set_header   X-Forwarded-Proto $forwarded_proto;
    proxy_set_header   X-Forwarded-Port $forwarded_port;

    proxy_pass         http://car_gui;
}
